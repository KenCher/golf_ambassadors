# CIIQ — Environment Variables Template
# Copy this file to .env and fill in your credentials.
#
#   cp .env.example .env
#   nano .env
#
# .env is gitignored — never commit real credentials.

# ── WatsonX credentials ────────────────────────────────────────────────────────
# IBM Cloud API key — get from: cloud.ibm.com → Manage → Access → API keys
CIIQ_WATSONX_API_KEY=your_ibm_cloud_api_key_here

# WatsonX project ID — get from: watsonx.ai → Projects → your_project → Manage
CIIQ_WATSONX_PROJECT_ID=your_watsonx_project_id_here

# WatsonX region — must match where your project was created
# Options: eu-de (Frankfurt), us-south (Dallas), eu-gb (London), jp-tok (Tokyo)
CIIQ_WATSONX_REGION=eu-de

# ── Flask session security ─────────────────────────────────────────────────────
# Generate a random string: python3 -c "import secrets; print(secrets.token_hex(32))"
CIIQ_SECRET_KEY=change_this_to_a_random_secret_string

# ── Latest CI run (update daily) ───────────────────────────────────────────────
# The UI will auto-populate these fields on load instead of showing stale defaults.
# Run date in YYYY-MM-DD format; Run ID is the numeric CI run number.
CIIQ_LATEST_RUN_DATE=2026-08-09
CIIQ_LATEST_RUN_ID=1592

# ── Git delta fallback ────────────────────────────────────────────────────────
# If tuxmaker SSH is unreachable, set this to the last-known-good kernel SHA.
# The /api/delta/<date> endpoint will use it to compute the git range.
# CIIQ_LAST_GOOD_SHA=abc1234def5678

# ── Optional overrides ─────────────────────────────────────────────────────────
# These override config.yaml values if set.
# CIIQ_LOG_BASE=/home/ciuser/logs/daily
# CIIQ_KERNEL_REPO=/home/ciuser/linux
# CIIQ_WORKERS=4
# CIIQ_PORT=5100
